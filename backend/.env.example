# Copy this file to .env and fill in the real values. Never commit .env.
# Local SQL Server defaults: server localhost, database LocalDeliveryMarketplace_Team_00, user sa.
DB_SERVER=localhost
DB_NAME=LocalDeliveryMarketplace_Team_00
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
# Secret used to sign the session cookie. Change this to a long random string.
SESSION_SECRET=change-this-to-a-long-random-string
